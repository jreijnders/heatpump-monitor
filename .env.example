# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me
INGESTER_PASSWORD=change-me
GRAFANA_RO_PASSWORD=change-me
CLAUDE_RO_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Broker on the home server.
MQTT_URL=tcp://192.168.1.40:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Fixed ID = persistent session (QoS 1 messages queued while the ingester is down).
# Use a DIFFERENT id when running a second ingester (e.g. locally on a laptop),
# otherwise the two kick each other off the Broker.
MQTT_CLIENT_ID=heatpump-monitor-ingester

LOG_LEVEL=info

# Host ports. Change locally if 5432/3000 are taken.
DB_PORT=5432
GRAFANA_PORT=3000

BACKUP_KEEP_DAYS=14
