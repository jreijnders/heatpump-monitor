          "rawSql": "SELECT cycle_start AS \"Start\", cycle_end AS \"End\", extract(epoch FROM duration) / 60 AS \"Duration (min)\" FROM compressor_cycles($__timeFrom(), $__timeTo()) ORDER BY cycle_start DESC"
