    {
      "id": 7,
      "type": "stat",
      "title": "COP (selected range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(heat_kwh) / NULLIF(sum(elec_kwh), 0) AS cop FROM energy_1m WHERE $__timeFilter(bucket) AND heat_kwh IS NOT NULL AND elec_kwh IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2.5
              },
              {
                "color": "green",
                "value": 3.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "description": "Sum of heat delivered / sum of electricity consumed over the selected range (energy_1m, minutes with both deltas only)."
    },
