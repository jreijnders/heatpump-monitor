    {
      "id": 21,
      "type": "barchart",
      "title": "Compressor Cycle duration histogram",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT label AS \"Duration\", count(*)::int AS cycles FROM (SELECT CASE WHEN m < 5 THEN '00-05' WHEN m < 10 THEN '05-10' WHEN m < 20 THEN '10-20' WHEN m < 30 THEN '20-30' WHEN m < 60 THEN '30-60' ELSE '60+' END AS label, CASE WHEN m < 5 THEN 1 WHEN m < 10 THEN 2 WHEN m < 20 THEN 3 WHEN m < 30 THEN 4 WHEN m < 60 THEN 5 ELSE 6 END AS ord FROM (SELECT extract(epoch FROM duration) / 60 AS m FROM compressor_cycles($__timeFrom(), $__timeTo()) WHERE duration IS NOT NULL) q) r GROUP BY label, ord ORDER BY ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "Duration",
        "legend": {
          "showLegend": false
        }
      },
      "description": "Completed cycles by duration (minutes)."
    },
