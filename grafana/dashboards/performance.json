            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT device AS \"Device\", last_time AS \"Last reading\", age_seconds AS \"Age (s)\", t AS \"Threshold (s)\", age_seconds / t AS \"Age / threshold\" FROM (SELECT *, CASE WHEN device IN ('heat_pump','electricity_meter') THEN 15 WHEN device = 'heat_meter' THEN 90 ELSE 30 END AS t FROM data_freshness) f ORDER BY device"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
